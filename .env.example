# Example only. Never commit actual credentials.
# For LibreChat running in Docker, localhost refers to its own container.
# Set this to an Ollama endpoint reachable from the LibreChat container.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
GOOGLE_KEY=
# Follow official LibreChat instructions for required secrets and MongoDB.

# Monolith chat gateway. Keep the token in the host environment, never in Git.
MONOLITH_BRIDGE_TOKEN=
MONOLITH_CHAT_PORT=8766
MONOLITH_UI_PASSWORD=
MONOLITH_WEB_HOST=127.0.0.1
MONOLITH_WEB_PORT=8000
MONOLITH_OLLAMA_URL=http://127.0.0.1:11434
MONOLITH_LLM_PRIMARY=llama3.2-vision:11b
MONOLITH_LLM_SECONDARY=
MONOLITH_LLM_EMERGENCY_ENABLED=false
MONOLITH_LIBRECHAT_HEALTH_URL=

# Configure only the real owner-provided endpoint and token for each agent.
MONOLITH_AGENT_ARIA_URL=
MONOLITH_AGENT_ARIA_TOKEN=
MONOLITH_AGENT_ALEX_URL=
MONOLITH_AGENT_ALEX_TOKEN=
MONOLITH_AGENT_ASTYRIA_URL=
MONOLITH_AGENT_ASTYRIA_TOKEN=
MONOLITH_AGENT_AURELIUS_URL=
MONOLITH_AGENT_AURELIUS_TOKEN=

# Optional authenticated, read-only HTTPS transmission source. Expected JSON:
# {"transmissions":[{"source":"...","timestamp_utc":"...","message":"..."}]}
MONOLITH_HYPERSPACE_URL=
MONOLITH_HYPERSPACE_TOKEN=
