JWT_REFRESH_SECRET=
# Database (adjust for your Docker deployment)
MONGO_URI=mongodb://mongodb:27017/LibreChat
# Monolith backend (not implemented yet)
MONOLITH_API_URL=
MONOLITH_API_TOKEN=
